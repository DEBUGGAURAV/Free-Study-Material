{
  "name": "freestudymaterial",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "build": "vite build",
    "render-build": "npm install && npm run build",
    "dev": "nodemon --watch src src/server.js",
    "client": "vite"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js,json",
    "ignore": [
      "cache/*",
      "dist/*",
      "uploads/*",
      "temp/*",
      "*.bin",
      "*.meta.json",
      "*.db"
    ]
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "minisearch": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "telegram": "^2.26.22",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.0",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "overrides": {
    "braces": "^3.0.3",
    "uuid": "^11.1.1",
    "chokidar": "^4.0.3"
  }
}
