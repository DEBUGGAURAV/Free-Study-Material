# Hybrid routing is handled cleanly by Cloudflare Pages Functions:
# - '/' & static assets (/robots.txt, /sw.js, /assets/*) -> served directly by CDN
# - '/api/*' -> functions/api/[[catchall]].js
# - '/sitemap.xml' -> functions/sitemap.xml.js
# - '/notes', '/branch/*', '/note/*', '/notices', '/chat', '/help' -> functions/[[path]].js (200 OK from /app/)
